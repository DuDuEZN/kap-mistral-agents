# Clé API Mistral — à créer sur https://console.mistral.ai/api-keys
# (jamais commitée ; le déploiement géré s'authentifie via son compte de service).
MISTRAL_API_KEY=

# Modèle de l'agent. Défaut : mistral-large-4.
# Note : devstral-2-25-12 et mistral-medium-3-5-26-04 sont dépréciés ; le remplacement
# recommandé pour les deux est mistral-large-4.
# DBA_MODEL=mistral-large-4

# Sandbox : mistral (défaut — requis en production gérée, fonctionne aussi en local),
# docker (conteneur Docker local, développement), bashkit (shell embarqué), none.
# En "none", l'agent n'a pas d'environnement et les skills ne sont pas chargées.
# DBA_SANDBOX=mistral
