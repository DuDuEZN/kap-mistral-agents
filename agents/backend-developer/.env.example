# Clé API Mistral — à créer sur https://console.mistral.ai/api-keys
# (jamais commitée ; le déploiement géré s'authentifie via son compte de service).
MISTRAL_API_KEY=

# Modèle de l'agent. Défaut : mistral-large-4.
# Note : devstral-2-25-12 et mistral-medium-3-5-26-04 sont dépréciés ;
# le remplacement recommandé pour les deux est mistral-large-4.
# AGENT_MODEL=mistral-large-4

# Sandbox : mistral (défaut), docker (dev local), bashkit, none.
# En "none", l'agent n'a pas d'environnement d'exécution.
# AGENT_SANDBOX=mistral
